# Ákritas backend — local development template
# Copy this file to app.env and replace every REPLACE_* value.
# Never commit app.env or reuse development secrets in production.

# Required runtime configuration
# Native backend: PostgreSQL exposed by docker-compose.local.yml.
# Docker Compose overrides this URL with the internal postgres hostname.
AKRITAS_DATABASE_URL=postgres://akritas:akritas_dev@127.0.0.1:55432/akritas?sslmode=disable
AKRITAS_PUBLIC_URL=http://localhost:8080

# Generate with: openssl rand -base64 32
AKRITAS_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Generate each value independently with: openssl rand -hex 32
AKRITAS_PAGINATION_SECRET=REPLACE_WITH_RANDOM_PAGINATION_SECRET
AKRITAS_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_BOOTSTRAP_TOKEN

# Browser and session configuration
AKRITAS_ALLOWED_ORIGINS=http://localhost:3000
AKRITAS_SESSION_IDLE_TTL=12h
AKRITAS_SESSION_ABSOLUTE_TTL=168h
AKRITAS_SESSION_COOKIE_SECURE=true
AKRITAS_SESSION_COOKIE_SAME_SITE=lax

# Authentication rate limits
AKRITAS_AUTH_RATE_LIMIT_ATTEMPTS=5
AKRITAS_AUTH_RATE_LIMIT_WINDOW=15m
AKRITAS_AUTH_RATE_LIMIT_MAX_KEYS=4096

# Database pool and pagination
AKRITAS_PAGINATION_TTL=15m
AKRITAS_DB_MAX_OPEN_CONNECTIONS=10
AKRITAS_DB_MAX_IDLE_CONNECTIONS=5
AKRITAS_DB_CONNECTION_MAX_LIFETIME=30m

# Incident monitoring
AKRITAS_MONITORING_POLL_INTERVAL=10s
AKRITAS_MONITORING_CONCURRENCY=2

# Optional absolute directory for remediation worktrees.
# Leave empty to use the runtime's default temporary directory.
AKRITAS_REMEDIATION_WORKSPACE_ROOT=
